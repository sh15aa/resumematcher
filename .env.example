# ==============================================================================
# ResumeMatcher — Environment Variables & API Keys Reference
# Copy this file to `.env` and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE AUTHENTICATION & DATABASE
# ------------------------------------------------------------------------------
# Obtain from: https://supabase.com -> Project Settings -> API
# Required for user accounts, session persistence, and subscription syncing.

# Frontend / Client-side (Vite build)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Backend / SSR / Cloudflare Nitro Server runtime
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 2. PAYMENT GATEWAY (RAZORPAY)
# ------------------------------------------------------------------------------
# Obtain from: https://dashboard.razorpay.com -> Settings -> API Keys
# Test Key format: rzp_test_xxxxxxxxxxxxxx
# Live Key format: rzp_live_xxxxxxxxxxxxxx

# Backend / Server Key ID
RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Frontend Key ID (used by Razorpay Checkout.js)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Backend Secret (optional / for server-side order generation and webhook verification)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ------------------------------------------------------------------------------
# 3. AI PROVIDER CONFIGURATION (GEMINI, OPENAI, OR GROK)
# ------------------------------------------------------------------------------
# Choose ONE of the providers below. The app automatically detects which API
# key is set, or you can explicitly set `AI_PROVIDER=gemini` (or `openai` / `grok`).

# OPTION A: Google Gemini (RECOMMENDED — Fast, Generous Free Tier, 1M Context)
# Obtain free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OPTION B: OpenAI (Industry Standard — Paid API credits required)
# Obtain from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# OPTION C: xAI Grok (Grok-2)
# Obtain from: https://console.x.ai/
# GROK_API_KEY=xai-your_grok_api_key_here
# GROK_MODEL=grok-2-latest

# (Optional) Explicitly force provider: "gemini" | "openai" | "grok" | "lovable"
# AI_PROVIDER=gemini

# (Legacy / Fallback) Lovable Gateway Key
# LOVABLE_API_KEY=your_lovable_key_here

# (Optional) Cron secret if running scheduled sync jobs
LOVABLE_CRON_SECRET=your_random_secure_cron_secret

